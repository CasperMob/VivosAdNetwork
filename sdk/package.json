{
  "name": "@vivosadnetwork/sdk",
  "version": "1.0.1",
  "description": "Official SDK for VivosAdNetwork - Easy ad integration for publishers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "advertising",
    "ads",
    "contextual-ads",
    "publisher",
    "monetization"
  ],
  "author": "VivosAdNetwork",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-application": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {}
}
